<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/routes.xsd">
    <router id="standard">
        <route frontName="checkout" id="checkout">
            <module name="Transbank_Webpay"/>
        </route>
        <route frontName="customer" id="customer">
            <module name="Transbank_Webpay" before="Magento_Customer"/>
        </route>
    </router>
</config>
